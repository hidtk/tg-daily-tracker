# --- Cloudflare Worker secrets (set with `wrangler secret put <NAME>` in apps/worker,
# --- or put them in apps/worker/.dev.vars for local `wrangler dev`) ---
BOT_TOKEN=123456789:AAAA-your-bot-token-from-BotFather
# Any long random string. Signs sessions AND is used as the Telegram webhook secret token.
SESSION_SECRET=change-me-to-a-long-random-string

# --- GitHub Actions ---
# Secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, D1_DATABASE_ID
# Variables: BOT_USERNAME (without @), WEBAPP_URL (https://tg-daily-tracker.<you>.workers.dev)

# --- Local Mini App dev outside Telegram (optional) ---
# A signed initData string; generate with: node scripts/dev-initdata.mjs
# VITE_DEV_INIT_DATA=
